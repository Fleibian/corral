# Project sources are their own repositories and must never be committed here -
# committing them would also defeat the "one project per sandbox" boundary.
Projects/

# Generated per launch by Start-Project.ps1.
Sandboxes/

# Package download caches, mapped read-write into the sandbox.
Cache/

# Upstream reference clone (kunchenguid/dotfiles), re-clonable.
Dotfiles/source/
