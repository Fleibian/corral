# Per-project WSL instances - multi-gigabyte VHDX files. The project inside is
# its own git repository; this repo only holds the tooling that creates them.
Instances/

# git bundle backups written by Remove-Project.ps1.
Projects/

# Downloaded rootfs and the exported base image.
Cache/

# Upstream reference clone (kunchenguid/dotfiles), re-clonable.
Dotfiles/source/

# Agent session state for work done on this repo itself. Anchored to the root:
# unanchored, it also matches Dotfiles/wsl/.claude/, which is deployed config
# that must be tracked. A clone would silently build an image without it.
/.claude/
